# Flowcase admin env template — safe to commit (placeholders only).
# Copy to .env for local dev; set the real values in Vercel → Settings → Environment Variables.

# Supabase (anon: public reads; service_role: admin writes — NEVER expose the role key to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# Login (quote passwords containing # or the value is truncated)
ADMIN_PASSWORD="ChangeMe#123"
ADMIN_SESSION_SECRET=64+ hex chars (openssl rand -hex 32)
ADMIN_EMAIL=admin@example.com  # optional — when set, login requires this email too

# Worker proxy (orders status, images, uploads, stats)
ADMIN_API_TOKEN=fc_...
WORKER_URL=https://YOUR_WORKER.workers.dev
